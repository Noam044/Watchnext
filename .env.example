# PostgreSQL (docker compose up -d lance une base sur le port 5433)
DATABASE_URL="postgresql://watchnext:watchnext@localhost:5433/watchnext?schema=public"
# Optionnel : connexion directe (sans pooler) utilisée par les migrations. Fournie par Neon sur Vercel.
# DATABASE_URL_UNPOOLED=""

# Secret Auth.js — générer avec : npx auth secret   (ou openssl rand -base64 32)
AUTH_SECRET="change-me"

# Clé API TMDB (https://www.themoviedb.org/settings/api)
# Accepte la clé v3 ("API Key") ou le jeton v4 ("API Read Access Token").
TMDB_API_KEY=""

# Langue des métadonnées TMDB (optionnel, défaut fr-FR)
TMDB_LANGUAGE="fr-FR"

# Adresse publique du site (optionnel : sur Vercel, l'URL de production est détectée)
# NEXT_PUBLIC_SITE_URL="https://watchnext.example"

# Emails (mot de passe oublié) : n'importe quel service SMTP (Brevo, Gmail avec mot de passe d'application, Resend…)
# Sans ces variables, les emails s'affichent dans la console en développement et la fonction est masquée en production.
# SMTP_URL="smtps://utilisateur:motdepasse@smtp-relay.brevo.com:465"
# EMAIL_FROM="Watchnext <adresse@exemple.fr>"

# Notifications push — générer une paire de clés avec : npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=""
# VAPID_PRIVATE_KEY=""
# VAPID_SUBJECT="mailto:toi@exemple.fr"
